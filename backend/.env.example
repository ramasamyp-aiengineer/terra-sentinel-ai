# Copy to .env and fill in. .env is gitignored. Never commit real values.

# --- Sign-in ---------------------------------------------------------------------------------
# On by default. TS_AUTH_ENABLED=false is for local development only.
# TS_AUTH_ENABLED=true
# First-run administrator (created only when there are no users yet).
# Leave the password empty to have one generated and saved to data/state/initial_admin_password.txt.
TS_ADMIN_USER=admin
TS_ADMIN_PASSWORD=
# TS_SESSION_TTL_H=12
# Behind a reverse proxy (Cloud Run): trust the proxy's X-Forwarded-For so lockouts and rate limits see real clients.
# TS_TRUST_PROXY=true
# TS_PROXY_HOPS=1

# --- Gemini (work-order narratives, grounded by tools) ---------------------------------------
# Option A: Gemini API key from Google AI Studio.
TS_GEMINI_API_KEY=
TS_GEMINI_MODEL=gemini-flash-latest
# Option B: Vertex AI (uses application-default credentials). Used only when no API key is set.
# TS_GCP_PROJECT=your-project
# TS_GCP_REGION=us-central1

# --- BigQuery (optional). A Gemini API key does NOT work here: BigQuery needs Google Cloud credentials. ---
# Check the connection any time:  python -m app.services.bq.doctor
# TS_DATA_BACKEND=bigquery
# TS_GCP_PROJECT=your-project-id
# TS_BQ_DATASET=terrasentinel
# TS_BQ_LOCATION=US
# TS_BQ_MAX_GB_BILLED=10
# Either run `gcloud auth application-default login`, or point at a service-account key (keep it outside the repo):
# TS_GOOGLE_CREDENTIALS_FILE=C:\keys\terrasentinel-bq.json
